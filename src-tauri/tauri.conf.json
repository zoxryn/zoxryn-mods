{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zoxryn Mods",
  "version": "0.1.7",
  "identifier": "com.zoxryn.mods",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Zoxryn Mods",
        "width": 1320,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#101015",
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "shortDescription": "Discover. Install. Play.",
    "longDescription": "A careful, local-first GTA V Legacy single-player mod manager.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Zoxryn Mods"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0MUM3OUQzQUM2ODc3ODQKUldTRWQyaXMwM2tjeE5Nd0NYV3FuaGxtMFNtQW9VckhrMzlOeDFZdkRhaGpDWm94cTczdk9NY1gK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/zoxryn/zoxryn-mods/releases/latest/download/latest.json"
      ]
    }
  },
  "mainBinaryName": "zoxryn-mods"
}
